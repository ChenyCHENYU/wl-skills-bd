{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agile-team.example/schemas/wl-api-contract-v1.json",
  "title": "WL API Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "protocolVersion",
    "source",
    "resource",
    "transport",
    "operations",
    "models",
    "frontend",
    "completion"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "wl-api-contract" },
    "protocolVersion": { "const": "1.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "const": "jh4j3-openapi3" },
        "mode": { "type": "string", "minLength": 1 },
        "contractHash": { "$ref": "#/$defs/hash" },
        "apiHash": { "$ref": "#/$defs/hash" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "module", "entity", "description", "permissionPrefix"],
      "properties": {
        "contractId": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "entity": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "permissionPrefix": { "type": "string", "minLength": 1 },
        "externalId": { "type": "string", "minLength": 1 }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["successCode", "envelope", "pagination", "controllerBasePath", "externalBasePath"],
      "properties": {
        "successCode": { "const": 2000 },
        "envelope": { "const": ["code", "message", "data"] },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestCurrent", "requestSize", "defaultCurrent", "defaultSize", "maxSize", "recordsPath", "totalPath"],
          "properties": {
            "requestCurrent": { "type": "string", "minLength": 1 },
            "requestSize": { "type": "string", "minLength": 1 },
            "defaultCurrent": { "type": "integer", "minimum": 1 },
            "defaultSize": { "type": "integer", "minimum": 1 },
            "maxSize": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "recordsPath": { "type": "string", "minLength": 1 },
            "totalPath": { "type": "string", "minLength": 1 }
          }
        },
        "controllerBasePath": { "$ref": "#/$defs/path" },
        "externalBasePath": { "$ref": "#/$defs/path" }
      }
    },
    "operations": {
      "type": "object",
      "required": ["page", "detail", "create", "update", "remove"],
      "properties": {
        "page": { "$ref": "#/$defs/operation" },
        "detail": { "$ref": "#/$defs/operation" },
        "create": { "$ref": "#/$defs/operation" },
        "update": { "$ref": "#/$defs/operation" },
        "remove": { "$ref": "#/$defs/operation" }
      },
      "additionalProperties": { "$ref": "#/$defs/operation" }
    },
    "extensionOperations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "relations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "validationRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/validationRule" }
    },
    "errors": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/error" }
    },
    "models": {
      "type": "object",
      "required": ["pageRequest", "createRequest", "updateRequest", "detailResponse", "pageResponse"],
      "properties": {
        "pageRequest": { "$ref": "#/$defs/model" },
        "createRequest": { "$ref": "#/$defs/model" },
        "updateRequest": { "$ref": "#/$defs/model" },
        "detailResponse": { "$ref": "#/$defs/model" },
        "pageResponse": { "$ref": "#/$defs/model" }
      },
      "additionalProperties": { "$ref": "#/$defs/model" }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiConfig", "pathParameterSyntax", "notes"],
      "properties": {
        "apiConfig": {
          "type": "object",
          "required": ["list", "getById", "save", "update", "remove"],
          "properties": {
            "list": { "$ref": "#/$defs/path" },
            "getById": { "$ref": "#/$defs/path" },
            "save": { "$ref": "#/$defs/path" },
            "update": { "$ref": "#/$defs/path" },
            "remove": { "$ref": "#/$defs/path" }
          },
          "additionalProperties": { "$ref": "#/$defs/path" }
        },
        "pathParameterSyntax": { "const": "RFC6570-simple" },
        "notes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractStatus", "openQuestions", "deviations", "skeletonOperations"],
      "properties": {
        "contractStatus": { "enum": ["draft", "confirmed"] },
        "openQuestions": { "type": "array", "items": { "type": "string" } },
        "deviations": { "type": "array", "items": { "type": ["string", "object"] } },
        "skeletonOperations": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "pattern": "^/" },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "controllerPath", "externalPath", "permission", "requestModel", "responseModel"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
        "controllerPath": { "$ref": "#/$defs/path" },
        "externalPath": { "$ref": "#/$defs/path" },
        "permission": { "type": "string", "minLength": 1 },
        "requestModel": { "type": "string", "minLength": 1 },
        "responseModel": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "idFrom": { "enum": ["path", "body", "none"] },
        "summary": { "type": "string" }
      }
    },
    "validationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "startField", "endField", "operations", "message", "source", "allowEqual"],
      "properties": {
        "kind": { "const": "chronology" },
        "startField": { "type": "string", "minLength": 1 },
        "endField": { "type": "string", "minLength": 1 },
        "allowEqual": { "type": "boolean" },
        "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["create", "update", "page"] } },
        "message": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "httpStatus", "message", "owner", "retryable", "operations"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "httpStatus": { "type": "integer", "minimum": 400, "maximum": 599 },
        "message": { "type": "string", "minLength": 1, "maxLength": 200 },
        "owner": { "type": "string", "minLength": 1, "maxLength": 100 },
        "retryable": { "type": "boolean" },
        "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
      }
    },
    "model": { "type": "array", "items": { "$ref": "#/$defs/field" } },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "required", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "type": { "enum": ["string", "integer", "number", "boolean", "array", "object"] },
        "format": { "type": "string" },
        "maxLength": { "type": "integer", "minimum": 1, "description": "兼容旧版契约；新契约统一写入 constraints.maxLength" },
        "default": {},
        "constraints": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "minLength": { "type": "integer", "minimum": 0 },
            "maxLength": { "type": "integer", "minimum": 0 },
            "pattern": { "type": "string", "minLength": 1 },
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "minExclusive": { "type": "boolean" },
            "maxExclusive": { "type": "boolean" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "totalDigits": { "type": "integer", "minimum": 1 },
            "fractionDigits": { "type": "integer", "minimum": 0 }
          }
        },
        "constraintSource": { "type": "string", "minLength": 1 },
        "enum": { "type": "array", "minItems": 1, "uniqueItems": true },
        "maxItems": { "type": "integer", "minimum": 1 },
        "x-semantic-id": { "type": "string", "minLength": 1 },
        "x-data-classification": { "type": "string", "minLength": 1 },
        "x-masking": { "type": "string", "minLength": 1 },
        "x-id-format": { "enum": ["opaque", "uuid", "numeric-string"] },
        "items": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "type": "string" }, "format": { "type": "string" } },
          "additionalProperties": false
        }
      }
    }
  }
}
