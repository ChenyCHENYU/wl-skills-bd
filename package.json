{
  "name": "@agile-team/wl-skills-bd",
  "version": "0.41.1",
  "description": "面向 Java 8、Spring Boot 2、jh4j-cloud 3 的后端规范、契约生成、质量门与 MCP（v0.41.1：完整能力目录单源、精准任务范围与真实校验回执）",
  "main": "lib/index.js",
  "bin": {
    "wl-skills-bd": "bin/wl-skills-bd.js"
  },
  "files": [
    "assets/",
    "bin",
    "files",
    "lib",
    "mcp",
    "docs/",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ai",
    "skills",
    "spring-boot",
    "mybatis",
    "jh4j-cloud",
    "backend",
    "checkstyle",
    "archunit",
    "pmd",
    "spotbugs",
    "spotless",
    "mcp",
    "agent",
    "copilot",
    "wl-skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/wl-skills-bd.git"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "agile-team",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "version:verify": "node scripts/verify-version.js",
    "pretest": "node scripts/preflight-env.js --required-java 8",
    "preverify": "node scripts/preflight-env.js --required-java 8",
    "preverify:quality-maven": "node scripts/preflight-env.js --required-java 8 --check-maven",
    "lint:skills": "node scripts/lint-skills.js",
    "lint:js": "node scripts/lint-js.js",
    "verify:quality-config": "node scripts/verify-java-quality.js",
    "verify:quality-maven": "node scripts/verify-java-quality.js --maven",
    "preverify:quality-codecc": "node scripts/preflight-env.js --required-java 8 --check-maven",
    "verify:quality-codecc": "node scripts/verify-codecc-quality.js",
    "capabilities:sync": "node scripts/sync-capabilities.js --write",
    "capabilities:check": "node scripts/sync-capabilities.js",
    "verify:doc-sync": "node scripts/verify-doc-sync.js",
    "verify:contract-invariants": "node scripts/verify-contract-invariants.js",
    "eval:quality": "node scripts/evaluate-quality.js",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "verify": "npm run support:check && npm run version:verify && npm run capabilities:check && npm run verify:doc-sync && npm run verify:contract-invariants && npm run lint:skills && npm run lint:js && npm run verify:quality-config && npm run eval:quality && npm run test:coverage",
    "release:check": "npm run verify && npm run verify:quality-maven && npm run verify:quality-codecc && npm pack --dry-run --ignore-scripts",
    "prepublishOnly": "npm run support:check && npm run release:check",
    "support:check": "node lib/shared-support-check.cjs",
    "compatibility:check": "node scripts/compatibility-check.cjs"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
