{
  "name": "@agile-team/wl-skills-bd",
  "version": "0.24.0",
  "description": "面向 Java 8、Spring Boot 2、jh4j-cloud 3 的后端工程规范、生产安全契约、代码生成、质量门、MCP 与数据治理闭环（v0.24.0：变更审查、平台适配、项目策略与精准修复）",
  "main": "lib/index.js",
  "bin": {
    "wl-skills-bd": "bin/wl-skills-bd.js"
  },
  "files": [
    "bin",
    "files",
    "lib",
    "mcp",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ai",
    "skills",
    "spring-boot",
    "mybatis",
    "jh4j-cloud",
    "backend",
    "checkstyle",
    "archunit",
    "pmd",
    "spotbugs",
    "spotless",
    "mcp",
    "agent",
    "copilot",
    "wl-skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/ycyplus163/wl-skills-bd.git"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "agile-team",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "version:verify": "node scripts/verify-version.js",
    "pretest": "node scripts/preflight-env.js --required-java 8",
    "preverify": "node scripts/preflight-env.js --required-java 8",
    "preverify:quality-maven": "node scripts/preflight-env.js --required-java 8 --check-maven",
    "lint:skills": "node scripts/lint-skills.js",
    "lint:js": "node scripts/lint-js.js",
    "verify:quality-config": "node scripts/verify-java-quality.js",
    "verify:quality-maven": "node scripts/verify-java-quality.js --maven",
    "capabilities:sync": "node scripts/sync-capabilities.js --write",
    "capabilities:check": "node scripts/sync-capabilities.js",
    "verify:doc-sync": "node scripts/verify-doc-sync.js",
    "verify:contract-invariants": "node scripts/verify-contract-invariants.js",
    "eval:quality": "node scripts/evaluate-quality.js",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "verify": "npm run version:verify && npm run capabilities:check && npm run verify:doc-sync && npm run verify:contract-invariants && npm run lint:skills && npm run lint:js && npm run verify:quality-config && npm run eval:quality && npm run test && npm run test:coverage",
    "release:check": "npm run verify && npm run verify:quality-maven && npm pack --dry-run --ignore-scripts",
    "prepublishOnly": "npm run release:check"
  }
}
